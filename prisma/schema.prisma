// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int                 @id @default(autoincrement())
  username           String              @unique
  email              String?             @unique
  password           String
  avatar             String?
  displayName        String?
  bio                String?
  favoriteTeamId     Int?
  favoriteTeam       Team?               @relation("UserFavoriteTeam", fields: [favoriteTeamId], references: [id])
  isAdmin            Boolean             @default(false)
  isEmailVerified    Boolean             @default(false)
  isDisabled         Boolean             @default(false)
  scoreAdjustment    Int                 @default(0)
  emailVerifyCode    String?
  emailVerifyExpires DateTime?
  createdAt          DateTime            @default(now())
  predictions        Prediction[]
  regularPredictions RegularPrediction[]
  createdProps       RegularProp[]       @relation("CreatedProps")
  propVotes          PropVote[]
}

model Prediction {
  id              Int      @id @default(autoincrement())
  user            User     @relation(fields: [userId], references: [id])
  userId          Int
  matchup         Matchup  @relation(fields: [matchupId], references: [id])
  matchupId       Int
  teamA           String
  teamB           String
  predictedWinner String
  predictedScore  String
  createdAt       DateTime @default(now())

  @@unique([userId, matchupId])
}

model Matchup {
  id           Int          @id @default(autoincrement())
  teamA        String
  teamB        String
  round        Int?
  conference   String
  actualWinner String?
  actualScore  String?
  predictions  Prediction[]
  lockTime     DateTime?
}

model Team {
  id                 Int                 @id
  name               String
  abbreviation       String
  logo               String
  color              String?
  conference         String?
  scrapedData        String?
  pendingData        String?
  isApproved         Boolean             @default(false)
  updatedAt          DateTime            @updatedAt
  fans               User[]              @relation("UserFavoriteTeam")
  homeMatchups       RegularMatchup[]    @relation("TeamA")
  awayMatchups       RegularMatchup[]    @relation("TeamB")
  wonMatchups        RegularMatchup[]    @relation("WonMatchups")
  regularPredictions RegularPrediction[]
}

model RegularMatchup {
  id             Int                 @id @default(autoincrement())
  espnId         String?             @unique
  teamAId        Int?
  teamA          Team?               @relation("TeamA", fields: [teamAId], references: [id])
  teamBId        Int?
  teamB          Team?               @relation("TeamB", fields: [teamBId], references: [id])
  customTeamA    String?
  customTeamB    String?
  customLogoA    String?
  customLogoB    String?
  isCustom       Boolean             @default(false)
  startTime      DateTime
  status         String              @default("SCHEDULED")
  clock          String?
  period         Int?
  scoreA         Int?
  scoreB         Int?
  actualWinnerId Int?
  actualWinner   Team?               @relation("WonMatchups", fields: [actualWinnerId], references: [id])
  customWinner   String?
  actualScore    String?
  isSettled      Boolean             @default(false)
  lockTime       DateTime
  openTime       DateTime
  predictions    RegularPrediction[]
  props          RegularProp[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model RegularPrediction {
  id                     Int            @id @default(autoincrement())
  userId                 Int
  user                   User           @relation(fields: [userId], references: [id])
  matchupId              Int
  matchup                RegularMatchup @relation(fields: [matchupId], references: [id])
  predictedWinnerId      Int?
  predictedWinner        Team?          @relation(fields: [predictedWinnerId], references: [id])
  customPredictedWinner  String?
  createdAt              DateTime       @default(now())

  @@unique([userId, matchupId])
}

model RegularProp {
  id               Int            @id @default(autoincrement())
  matchupId        Int
  matchup          RegularMatchup @relation(fields: [matchupId], references: [id])
  creatorId        Int
  creator          User           @relation("CreatedProps", fields: [creatorId], references: [id])
  question         String
  playerName       String?
  statType         String?
  threshold        Float?
  actualStatValue  Float?
  resolvedOutcome  String?
  isResolved       Boolean        @default(false)
  isSettled        Boolean        @default(false)
  votes            PropVote[]
  createdAt        DateTime       @default(now())
}

model PropVote {
  id        Int         @id @default(autoincrement())
  propId    Int
  prop      RegularProp @relation(fields: [propId], references: [id])
  userId    Int
  user      User        @relation(fields: [userId], references: [id])
  vote      String
  createdAt DateTime    @default(now())

  @@unique([userId, propId])
}

model SystemLog {
  id        Int      @id @default(autoincrement())
  action    String
  details   String
  level     String   @default("INFO")
  createdAt DateTime @default(now())
}
