// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int                 @id @default(autoincrement())
  username           String              @unique
  email              String?             @unique
  password           String
  isAdmin            Boolean             @default(false)
  isEmailVerified    Boolean             @default(false)
  emailVerifyCode    String?
  predictions        Prediction[]
  regularPredictions RegularPrediction[]
}

model Prediction {
  id              Int      @id @default(autoincrement())
  user            User     @relation(fields: [userId], references: [id])
  userId          Int
  matchup         Matchup  @relation(fields: [matchupId], references: [id])
  matchupId       Int
  teamA           String
  teamB           String
  predictedWinner String
  predictedScore  String
  createdAt       DateTime @default(now())

  @@unique([userId, matchupId])
}

model Matchup {
  id           Int          @id @default(autoincrement())
  teamA        String
  teamB        String
  round        Int?
  conference   String
  actualWinner String?
  actualScore  String?
  predictions  Prediction[]
  lockTime     DateTime?
}

model Team {
  id                 Int                 @id
  name               String
  abbreviation       String
  logo               String
  color              String?
  conference         String?
  scrapedData        String?
  pendingData        String?
  isApproved         Boolean             @default(false)
  updatedAt          DateTime            @updatedAt
  homeMatchups       RegularMatchup[]    @relation("TeamA")
  awayMatchups       RegularMatchup[]    @relation("TeamB")
  wonMatchups        RegularMatchup[]    @relation("WonMatchups")
  regularPredictions RegularPrediction[]
}

model RegularMatchup {
  id             Int                 @id @default(autoincrement())
  espnId         String?             @unique
  teamAId        Int
  teamA          Team                @relation("TeamA", fields: [teamAId], references: [id])
  teamBId        Int
  teamB          Team                @relation("TeamB", fields: [teamBId], references: [id])
  startTime      DateTime
  status         String              @default("SCHEDULED")
  clock          String?
  period         Int?
  scoreA         Int?
  scoreB         Int?
  actualWinnerId Int?
  actualWinner   Team?               @relation("WonMatchups", fields: [actualWinnerId], references: [id])
  actualScore    String?
  isSettled      Boolean             @default(false)
  lockTime       DateTime
  openTime       DateTime
  predictions    RegularPrediction[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model RegularPrediction {
  id                Int            @id @default(autoincrement())
  userId            Int
  user              User           @relation(fields: [userId], references: [id])
  matchupId         Int
  matchup           RegularMatchup @relation(fields: [matchupId], references: [id])
  predictedWinnerId Int
  predictedWinner   Team           @relation(fields: [predictedWinnerId], references: [id])
  createdAt         DateTime       @default(now())

  @@unique([userId, matchupId])
}

model SystemLog {
  id        Int      @id @default(autoincrement())
  action    String
  details   String
  level     String   @default("INFO")
  createdAt DateTime @default(now())
}
