DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
CRON_SECRET="replace-with-a-long-random-cron-secret"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@example.com"
SMTP_PASS="your-app-password"
SMTP_FROM="NBA Predictor Hub 2026-27 <your-email@example.com>"

ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-strong-admin-password"
ADMIN_EMAIL="admin@example.com"

# Local filesystem uploads are not durable on Vercel. Keep false in production
# until Supabase Storage, S3, or Cloudflare R2 is wired in.
LOCAL_AVATAR_UPLOADS_ENABLED="false"
